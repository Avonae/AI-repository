{
  "model": "opus",
  "enabledPlugins": {
    "caveman@caveman": true,
    "ansible-skills@ansible-skills-marketplace": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "git",
        "url": "https://github.com/juliusbrussee/caveman.git"
      }
    },
    "ansible-skills-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/realsigridjin/hello-ansible-skills.git"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}